---
import { url, type Proyecto } from '../lib/proyectos';
interface Props { p: Proyecto; grande?: boolean; carga?: 'lazy' | 'eager' }
const { p, grande = false, carga = 'lazy' } = Astro.props;
const d = p.data;
const imagen = d.poster ?? d.galeria?.[0];
---
<a class:list={['tarjeta', { grande }]} href={url(p)} data-cat={d.categoria}>
  <div class="marco">
    {imagen && <img src={imagen} alt={`${d.cliente} – ${d.titulo}`} loading={carga} decoding="async" onerror="this.remove()" />}
    {d.preview && <video src={d.preview} muted loop playsinline preload="none"></video>}
    {d.video && <span class="play" aria-hidden="true"></span>}
    {d.galeria && <span class="num">{d.galeria.length} fotos</span>}
  </div>
  <div class="pie-t">
    <span class="nombre">{d.cliente} <span class="tenue">‘{d.titulo}’</span></span>
    {(d.rol.length > 0 || d.año) && <span class="etiqueta">{[d.rol.slice(0, 2).join(' · '), d.año].filter(Boolean).join(' — ')}</span>}
  </div>
</a>
<style>
  .tarjeta { display: block; }
  .tarjeta[hidden] { display: none; }
  .marco { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #111; }
  .grande .marco { aspect-ratio: 16 / 8.5; }
  .marco img, .marco video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.7,.2,1), opacity .4s; }
  .marco video { opacity: 0; }
  .tarjeta:hover .marco img { transform: scale(1.04); }
  .tarjeta:hover .marco video { opacity: 1; }
  .play { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; background: rgba(0,0,0,.35); backdrop-filter: blur(6px); opacity: 0; transform: scale(.85); transition: opacity .3s, transform .3s; }
  .play::after { content: ''; position: absolute; left: 26px; top: 21px; border-left: 16px solid #fff; border-top: 11px solid transparent; border-bottom: 11px solid transparent; }
  .tarjeta:hover .play { opacity: 1; transform: scale(1); }
  .num { position: absolute; right: .7rem; bottom: .6rem; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; background: rgba(0,0,0,.5); padding: .25rem .5rem; }
  .pie-t { display: flex; flex-direction: column; gap: .2rem; padding: .7rem 0 0; }
  .nombre { font-size: 1rem; letter-spacing: -.01em; }
  .grande .nombre { font-size: clamp(1rem, 1.5vw, 1.3rem); }
  @media (hover: none) { .play { opacity: .9; transform: none; } }
</style>
