---
import { url, type Proyecto } from '../lib/proyectos';
interface Props {
  proyectos: Proyecto[];
  grupos?: Record<string, string>;   // categoría → título del grupo (si se agrupa)
  filtros?: boolean;
  columnas?: 3 | 4;
}
const { proyectos, grupos, filtros = false, columnas = 4 } = Astro.props;
const bloques = grupos
  ? Object.entries(grupos).map(([c, n]) => ({ c, n, items: proyectos.filter((p) => p.data.categoria === c) })).filter((b) => b.items.length)
  : [{ c: 'todo', n: '', items: proyectos }];
---
{filtros && grupos && (
  <nav class="filtros" aria-label="Filtrar">
    <button class="etiqueta activo" data-filtro="todo">Todo <sup>{proyectos.length}</sup></button>
    {bloques.map((b) => <button class="etiqueta" data-filtro={b.c}>{b.n} <sup>{b.items.length}</sup></button>)}
  </nav>
)}
<div class:list={['lista', `c${columnas}`]} data-lista>
  {bloques.map((b) => (
    <section class="grupo" data-grupo={b.c}>
      {b.n && <h2 class="etiqueta">{b.n}</h2>}
      <ul>
        {b.items.map((p) => {
          const d = p.data;
          const img = d.poster ?? d.galeria?.[0];
          return (
            <li>
              <a href={url(p)}>
                <span class="mini">
                  {img && <img src={img} alt="" loading="lazy" decoding="async" onerror="this.remove()" />}
                  {d.preview && <video src={d.preview} muted loop playsinline preload="none"></video>}
                </span>
                <span class="titulo">{d.cliente} <span class="obra">‘{d.titulo}’</span></span>
                <span class="meta etiqueta">
                  {d.rol.length > 0 && <span>{d.rol.slice(0, 2).join(' · ')}</span>}
                  {d.galeria && <span>{d.galeria.length} fotos</span>}
                  {d.año && <span>{d.año}</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>

<style>
  .filtros { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; margin: 0 0 2.5rem; }
  .filtros button { background: none; border: 0; padding: 0; cursor: pointer; font-family: inherit; }
  .filtros button.activo, .filtros button:hover { color: var(--fg); }
  .filtros sup { font-size: 8px; }
  .grupo { margin-bottom: 3.5rem; }
  .grupo[hidden] { display: none; }
  .grupo h2 { margin: 0 0 1rem; padding-bottom: .6rem; border-bottom: 1px solid var(--linea); font-weight: 450; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem 1rem; }
  li a { display: flex; flex-direction: column; gap: .2rem; transition: opacity .25s; }
  .mini { position: relative; display: block; aspect-ratio: 16 / 9; background: #111; overflow: hidden; margin-bottom: .45rem; }
  .mini img, .mini video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mini img { filter: grayscale(.3); transition: filter .3s, transform 1s cubic-bezier(.2,.7,.2,1); }
  .mini video { opacity: 0; transition: opacity .3s; }
  li a:hover .mini img { filter: none; transform: scale(1.03); }
  li a:hover .mini video { opacity: 1; }
  .titulo { font-size: .95rem; letter-spacing: -.01em; line-height: 1.25; }
  .obra { color: var(--tenue); transition: color .25s; }
  li a:hover .obra { color: var(--fg); }
  .meta { display: flex; flex-wrap: wrap; gap: .1rem .8rem; }
  /* Al pasar por encima, se atenúa todo menos la miniatura activa */
  .lista:has(a:hover) a:not(:hover) { opacity: .35; }
  .c3 ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 1100px) { ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem .75rem; } .titulo { font-size: .88rem; } }
  @media (hover: none) { .mini img { filter: none; } .lista:has(a:hover) a:not(:hover) { opacity: 1; } }
</style>

<script>
  const lista = document.querySelector<HTMLElement>('[data-lista]');
  // Clip de vista previa al pasar el ratón (si la ficha tiene `preview`)
  lista?.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
    const v = a.querySelector('video');
    if (!v) return;
    a.addEventListener('mouseenter', () => v.play().catch(() => {}));
    a.addEventListener('mouseleave', () => v.pause());
  });
  // Filtros
  const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const aplicar = (f: string) => {
    botones.forEach((b) => b.classList.toggle('activo', b.dataset.filtro === f));
    lista?.querySelectorAll<HTMLElement>('[data-grupo]').forEach((g) => (g.hidden = f !== 'todo' && g.dataset.grupo !== f));
  };
  botones.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filtro!;
    aplicar(f);
    history.replaceState(null, '', f === 'todo' ? location.pathname : `#${f}`);
  }));
  const h = location.hash.slice(1);
  if (h && botones.some((b) => b.dataset.filtro === h)) aplicar(h);
</script>
