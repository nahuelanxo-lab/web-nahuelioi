---
import Lista from './Lista.astro';
import type { Proyecto } from '../lib/proyectos';
interface Props { lista: Proyecto[]; actual: Proyecto; titulo: string; enlace: string }
const { lista, actual, titulo, enlace } = Astro.props;
const i = lista.findIndex((p) => p.id === actual.id);
const rot = [...lista.slice(i + 1), ...lista.slice(0, i)];
const sel = [...rot.filter((p) => p.data.categoria === actual.data.categoria), ...rot.filter((p) => p.data.categoria !== actual.data.categoria)].slice(0, 4);
---
{sel.length > 0 && (
  <section class="mas">
    <div class="cab"><h2 class="etiqueta">Más trabajos</h2><a class="etiqueta" href={enlace}>{titulo} →</a></div>
    <Lista proyectos={sel} />
  </section>
)}
<style>
  .mas { margin-top: clamp(4rem, 10vw, 7rem); }
  .cab { display: flex; justify-content: space-between; margin-bottom: .9rem; }
  .cab h2 { margin: 0; font-weight: 450; }
  .cab a:hover { color: var(--fg); }
</style>
