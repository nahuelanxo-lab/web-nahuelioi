---
import { CATEGORIAS, type Proyecto } from '../lib/proyectos';
interface Props { proyectos: Proyecto[]; agrupar?: boolean; filtros?: boolean }
const { proyectos, agrupar = true, filtros = false } = Astro.props;
const grupos = agrupar
  ? (Object.keys(CATEGORIAS) as (keyof typeof CATEGORIAS)[])
      .map((c) => ({ c, items: proyectos.filter((p) => p.data.categoria === c) }))
      .filter((g) => g.items.length)
  : [{ c: null, items: proyectos }];
---
{filtros && (
  <div class="filtros" role="group" aria-label="Filtrar por categoría">
    <button class="etiqueta activo" data-filtro="todo">Todo <sup>{proyectos.length}</sup></button>
    {Object.entries(CATEGORIAS).map(([c, n]) => {
      const total = proyectos.filter((p) => p.data.categoria === c).length;
      return total > 0 && <button class="etiqueta" data-filtro={c}>{n} <sup>{total}</sup></button>;
    })}
  </div>
)}
<div class="lista" data-lista>
  {grupos.map(({ c, items }) => (
    <section class="grupo" data-grupo={c ?? 'todo'}>
      {c && <h2 class="etiqueta">{CATEGORIAS[c]}</h2>}
      <ul>
        {items.map((p) => (
          <li data-cat={p.data.categoria}>
            <a href={`/trabajos/${p.id}/`} data-poster={p.data.poster} data-preview={p.data.preview}>
              {p.data.poster ? <img class="mini" src={p.data.poster} alt="" loading="lazy" onerror="this.style.visibility='hidden'" /> : <span class="mini" />}
              <span class="titulo">{p.data.cliente} <span class="obra">‘{p.data.titulo}’</span></span>
              <span class="meta etiqueta">
                {p.data.rol.length > 0 && <span>{p.data.rol.join(' · ')}</span>}
                {p.data.productora && <span class="prod">{p.data.productora}</span>}
                {p.data.año && <span>{p.data.año}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
<div class="vista" aria-hidden="true"><img alt="" /><video muted loop playsinline></video></div>

<style>
  .filtros { display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; margin: 0 0 2.5rem; }
  .filtros button { background: none; border: 0; padding: 0; cursor: pointer; font-family: inherit; }
  .filtros button.activo, .filtros button:hover { color: var(--fg); }
  .filtros sup { font-size: 8px; }
  .grupo { margin-bottom: 3.5rem; }
  .grupo h2 { margin: 0 0 1rem; font-weight: 450; }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 1rem; padding: .42rem 0; border-top: 1px solid var(--linea); transition: opacity .25s; }
  li:last-child a { border-bottom: 1px solid var(--linea); }
  .titulo { font-size: clamp(1.05rem, 1.6vw, 1.35rem); letter-spacing: -.01em; }
  .obra { color: var(--tenue); transition: color .25s; }
  .meta { display: flex; gap: 1rem; justify-content: flex-end; text-align: right; }
  .mini { display: none; }
  /* Al pasar por encima de la lista, todo se atenúa menos la fila activa */
  .lista:has(a:hover) a:not(:hover) { opacity: .28; }
  li a:hover .obra { color: var(--fg); }

  .vista { position: fixed; left: 0; top: 0; width: min(36vw, 520px); aspect-ratio: 16 / 9; pointer-events: none; z-index: 10; opacity: 0; transition: opacity .2s; overflow: hidden; background: #111; }
  .vista.on { opacity: 1; }
  .vista img[src=''], .vista img:not([src]) { visibility: hidden; }
  .vista img, .vista video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vista video { display: none; }
  .vista.video video { display: block; }

  @media (hover: none), (max-width: 760px) {
    .vista { display: none; }
    li a { grid-template-columns: 96px 1fr; grid-template-rows: auto auto; align-items: center; align-content: center; column-gap: .9rem; row-gap: .15rem; padding: .6rem 0; }
    .titulo { align-self: end; } .meta { align-self: start; }
    .mini { display: block; grid-row: 1 / span 2; width: 96px; aspect-ratio: 16/9; object-fit: cover; background: #111; }
    .meta { justify-content: flex-start; text-align: left; flex-wrap: wrap; gap: .2rem .8rem; }
    .meta .prod { display: none; }
    .lista:has(a:hover) a:not(:hover) { opacity: 1; }
  }
</style>

<script>
  const vista = document.querySelector<HTMLDivElement>('.vista')!;
  const img = vista.querySelector('img')!;
  const vid = vista.querySelector('video')!;
  const lista = document.querySelector<HTMLElement>('[data-lista]')!;
  let x = 0, y = 0, cx = 0, cy = 0, raf = 0;
  const mover = () => {
    cx += (x - cx) * 0.18; cy += (y - cy) * 0.18;
    const w = vista.offsetWidth, h = vista.offsetHeight;
    const left = Math.min(cx + 24, innerWidth - w - 16);
    vista.style.transform = `translate(${left}px, ${Math.max(16, Math.min(cy - h / 2, innerHeight - h - 16))}px)`;
    raf = requestAnimationFrame(mover);
  };
  lista.querySelectorAll<HTMLAnchorElement>('a[data-poster]').forEach((a) => {
    a.addEventListener('mouseenter', () => {
      img.src = a.dataset.poster!;
      if (a.dataset.preview) { vid.src = a.dataset.preview; vid.play().catch(() => {}); vista.classList.add('video'); }
      else { vid.removeAttribute('src'); vista.classList.remove('video'); }
      vista.classList.add('on');
      if (!raf) raf = requestAnimationFrame(mover);
    });
    a.addEventListener('mouseleave', () => { vista.classList.remove('on'); vid.pause(); });
  });
  addEventListener('mousemove', (e) => { x = e.clientX; y = e.clientY; }, { passive: true });

  // Filtros (solo en /trabajos/)
  document.querySelectorAll<HTMLButtonElement>('[data-filtro]').forEach((b) => {
    b.addEventListener('click', () => {
      const f = b.dataset.filtro;
      document.querySelectorAll('[data-filtro]').forEach((o) => o.classList.toggle('activo', o === b));
      lista.querySelectorAll<HTMLElement>('[data-grupo]').forEach((g) => {
        g.hidden = f !== 'todo' && g.dataset.grupo !== f;
      });
    });
  });
</script>
