---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Lista from '../components/Lista.astro';
import { publicados, videos, fotos } from '../lib/proyectos';
const todos = await publicados();
const destacados = todos.filter((p) => p.data.destacado);
// Reel de portada: public/media/reel.mp4 (+ reel.jpg como imagen de espera).
// Mientras no exista, el recuadro muestra imágenes de los destacados.
const hayReel = existsSync('public/media/reel.mp4');
const conTexto = ['2024_concello-de-o-grove_o-grove', 'sf_hotel-puente-la-toja_descubre-la-toja-y-o-grove'];
const diapos = destacados.filter((p) => !conTexto.includes(p.id)).map((p) => p.data.poster).filter(Boolean) as string[];
const nVideo = (await videos()).length;
const nFoto = (await fotos()).length;
---
<Base>
  <section class="hero">
    <div class="texto">
      <p class="lema">Director de fotografía y cámara para publicidad, videoclips y piezas de marca.</p>
      <nav class="accesos">
        <a href="/video/">Vídeo <sup>{nVideo}</sup></a>
        <a href="/fotografia/">Fotografía <sup>{nFoto}</sup></a>
        <a href="/informacion/">Contacto</a>
      </nav>
    </div>
    <div class="reel">
      {hayReel ? (
        <video src="/media/reel.mp4" poster={existsSync('public/media/reel.jpg') ? '/media/reel.jpg' : undefined} autoplay muted loop playsinline preload="auto"></video>
      ) : (
        diapos.map((src, i) => <img class:list={['diapo', { on: i === 0 }]} src={src} alt="" loading={i < 2 ? 'eager' : 'lazy'} />)
      )}
      <span class="etiqueta rotulo">Reel</span>
    </div>
  </section>

  <section class="seleccion">
    <div class="cab"><h1 class="etiqueta">Selección</h1><a class="etiqueta" href="/video/">Todo el vídeo →</a></div>
    <Lista proyectos={destacados} />
  </section>

  <section class="marcas">
    <p class="etiqueta">He trabajado con</p>
    <p>VisualVR · TreceAmarillo · MINT · Fish&amp;Rock · DYR · Modelocero · Orixe Creative</p>
  </section>
</Base>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: end; padding-top: clamp(6rem, 16vh, 10rem); }
  .lema { font-size: clamp(1.5rem, 2.8vw, 2.6rem); line-height: 1.07; letter-spacing: -.03em; font-weight: 420; margin: 0 0 2rem; max-width: 18ch; }
  .accesos { display: flex; flex-wrap: wrap; gap: .4rem 1.5rem; font-size: 1.05rem; }
  .accesos a { color: var(--tenue); transition: color .2s; }
  .accesos a:hover { color: var(--fg); }
  .accesos sup { font-size: .6em; }
  .reel { position: relative; aspect-ratio: 16 / 9; max-height: 62vh; width: 100%; background: #111; overflow: hidden; justify-self: end; }
  .reel video, .reel img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .diapo { opacity: 0; transition: opacity 1.4s ease; }
  .diapo.on { opacity: 1; }
  .rotulo { position: absolute; left: .75rem; bottom: .6rem; color: rgba(255,255,255,.85); }
  .seleccion { margin-top: clamp(4rem, 10vw, 7rem); }
  .cab { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .9rem; }
  .cab h1 { margin: 0; font-weight: 450; }
  .cab a:hover { color: var(--fg); }
  .marcas { margin-top: 5rem; }
  .marcas p:last-child { font-size: clamp(1rem, 1.8vw, 1.4rem); letter-spacing: -.015em; color: var(--tenue); margin: .6rem 0 0; max-width: 46ch; }
  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; padding-top: 5.5rem; }
    .reel { order: -1; }
    .lema { margin-bottom: 1.25rem; }
  }
</style>
<script>
  const d = [...document.querySelectorAll<HTMLImageElement>('.diapo')];
  let i = 0;
  if (d.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => { d[i].classList.remove('on'); i = (i + 1) % d.length; d[i].classList.add('on'); }, 3500);
  }
</script>
