---
import Base from '../../layouts/Base.astro';
import ListaProyectos from '../../components/ListaProyectos.astro';
import { publicados } from '../../lib/proyectos';
const proyectos = await publicados();
---
<Base title="Trabajos" description="Trabajos de Nahuel Lioi como director de fotografía, operador de cámara, gaffer y fotógrafo: publicidad, videoclips, directo y fotografía.">
  <h1 class="titulo-pag">Trabajos</h1>
  <ListaProyectos proyectos={proyectos} filtros />
</Base>
<style>
  .titulo-pag { font-size: clamp(2rem, 5vw, 4rem); letter-spacing: -.03em; font-weight: 420; margin: 18vh 0 2rem; }
</style>
