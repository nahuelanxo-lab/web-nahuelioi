---
import '@fontsource-variable/inter-tight';
interface Props { title?: string; description?: string; image?: string; completo?: boolean }
const {
  title,
  description = 'Nahuel Lioi — director de fotografía y operador de cámara en Galicia. Publicidad, videoclips y fotografía para productoras, agencias y marcas.',
  image,
} = Astro.props;
const fullTitle = title ? `${title} — Nahuel Lioi` : 'Nahuel Lioi — Director de fotografía';
const path = Astro.url.pathname;
const activo = (h: string) => (path.startsWith(h) ? 'activo' : undefined);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="robots" content="noindex" /><!-- quitar al publicar en nahuelioi.com -->
  </head>
  <body>
    <header class="cabecera">
      <a href="/" class="marca">Nahuel Lioi</a>
      <span class="etiqueta oficio">Director de fotografía · Cámara</span>
      <nav>
        <a href="/video/" class={activo('/video')}>Vídeo</a>
        <a href="/fotografia/" class={activo('/fotografia')}>Fotografía</a>
        <a href="/informacion/" class={activo('/informacion')}>Información</a>
      </nav>
    </header>
    <main class:list={[{ completo: Astro.props.completo }]}><slot /></main>
    <footer class="pie">
      <span class="etiqueta">© {new Date().getFullYear()} Nahuel Lioi · Vigo, Galicia</span>
      <a class="etiqueta" href="mailto:nahuelanxo@gmail.com">nahuelanxo@gmail.com</a>
      <a class="etiqueta" href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;">Volver arriba</a>
    </footer>
  </body>
</html>
<style is:global>
  :root {
    --bg: #000; --fg: #fff; --tenue: #8a8a8a; --linea: #222;
    --pad: clamp(1rem, 3vw, 2.25rem);
    --font: 'Inter Tight Variable', 'Helvetica Neue', Arial, sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font); font-size: 16px; line-height: 1.35; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  ::selection { background: #fff; color: #000; }
  main { padding: 0 var(--pad); min-height: 70vh; }
  main.completo { padding: 0; }
  .cabecera { color: #fff; }
  .titulo-pag { font-size: clamp(2.2rem, 6vw, 5rem); letter-spacing: -.035em; font-weight: 420; line-height: 1; margin: 16vh 0 2rem; }
  .etiqueta { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--tenue); font-weight: 450; }
  .tenue { color: var(--tenue); }

  .cabecera { position: fixed; left: 0; right: 0; top: 0; z-index: 20; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 1.1rem var(--pad); mix-blend-mode: difference; }
  .cabecera .marca { font-weight: 500; letter-spacing: -.01em; }
  .cabecera nav { justify-self: end; display: flex; gap: 1.5rem; }
  .cabecera nav a { opacity: .55; transition: opacity .2s; }
  .cabecera nav a:hover, .cabecera nav a.activo { opacity: 1; }
  @media (max-width: 760px) { .cabecera { grid-template-columns: 1fr auto; } .oficio { display: none; } .cabecera nav { gap: 1rem; } }

  .pie { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding: 4rem var(--pad) 1.5rem; }
  .pie a:hover { color: var(--fg); }
</style>
